<% content_for :title, t(".title", id: @check.id) %>

<div class="mb-6">
  <%= link_to @check.repository.full_name, repository_path(@check.repository), class: "text-sm text-violet-700 hover:underline" %>
  <h1 class="text-3xl font-bold"><%= t(".title", id: @check.id) %></h1>
</div>

<dl class="mb-8 grid gap-2 rounded-lg border border-slate-200 bg-white p-6 text-sm sm:grid-cols-2">
  <div><dt class="text-slate-500"><%= Repository::Check.human_attribute_name(:aasm_state) %></dt><dd><%= @check.aasm.human_state %></dd></div>
  <div><dt class="text-slate-500"><%= Repository::Check.human_attribute_name(:passed) %></dt><dd><%= t(@check.passed? ? ".passed" : ".not_passed") %></dd></div>
  <div><dt class="text-slate-500"><%= Repository::Check.human_attribute_name(:commit_id) %></dt><dd class="font-mono"><%= @check.commit_id %></dd></div>
  <div><dt class="text-slate-500"><%= Repository::Check.human_attribute_name(:offenses_count) %></dt><dd><%= @check.offenses_count %></dd></div>
</dl>

<% if @check.offenses.any? %>
  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-100 text-slate-600">
        <tr>
          <th class="px-4 py-3"><%= t(".file") %></th>
          <th class="px-4 py-3"><%= t(".line") %></th>
          <th class="px-4 py-3"><%= t(".rule") %></th>
          <th class="px-4 py-3"><%= t(".message") %></th>
        </tr>
      </thead>
      <tbody>
        <% @check.offenses.each do |offense| %>
          <tr class="border-t border-slate-200">
            <td class="px-4 py-3 font-mono"><%= offense[:path] %></td>
            <td class="px-4 py-3"><%= offense[:line] %></td>
            <td class="px-4 py-3"><%= offense[:rule] %></td>
            <td class="px-4 py-3"><%= offense[:message] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
